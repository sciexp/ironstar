.astro/

# dependencies
node_modules/

# logs
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# data
data/

# Prometheus runtime artifact (services-flake creates data/prom1/queries.active)
/queries.active

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# nix
result
result-*
.direnv/
.pre-commit-config.yaml
biome.json

# jj workspaces
.worktrees/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
!.env.example

# sops secrets - only allow encrypted yaml/json files and documentation
# IMPORTANT: All .yaml and .json files in vars/ MUST be encrypted with sops
vars/*
!vars/*.yaml
!vars/*.json
!vars/README.md

# playwright test outputs
test-results/
playwright-report/

# test coverage
coverage/
# obsidian
.obsidian/

# bv (beads viewer) local config and caches
.bv/
*.html

# D2 rendered output (regenerated from source)
docs/notes/event-modeling/rendered/

# Idris2 build artifacts
spec/build/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Python bytecode caches
__pycache__/
*.pyc

# CLI http cache
http_cache.sqlite

# Machine-local project-context files. In this project AGENTS.md and CLAUDE.md
# are symlinks into a separate planning repository, so they are deliberately
# untracked here rather than absent by oversight.
# Stopgap: remove this entry when this repository lands its own committed
# project-context files, so that committing them is possible again without the
# staging silently doing nothing.
AGENTS.md
CLAUDE.md
